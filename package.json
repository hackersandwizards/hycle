{
  "name": "hycle-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "hycle.org: Astro-Seiten, gebaut nach dist/, ohne JavaScript auf der Seite.",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://hycle.org",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate dist",
    "lint:css": "stylelint public/style.css",
    "lint:code": "bun --bun scripts/lint-code.mjs",
    "lint:staged": "bun run lint:code --staged",
    "lint": "bun run lint:html && bun run lint:css && bun run lint:code",
    "links": "bun run links:external --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "links:external": "linkinator '**/*.html' --server-root dist",
    "lighthouse": "lhci autorun",
    "gen:sitemap": "bun scripts/gen-sitemap.mjs",
    "gen:assets": "bun scripts/gen-assets.mjs",
    "audit": "bun audit --audit-level=high",
    "check": "bun run scripts/check.mjs",
    "test": "bun --bun vitest run",
    "explore": "bun scripts/explore.mjs",
    "check:push": "bun run scripts/check.mjs --push",
    "check:cycles": "bun run scripts/cycles.mjs",
    "check:licenses": "bun run scripts/licenses.mjs",
    "mutation": "bun run scripts/mutation.mjs"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@fast-check/vitest": "0.5.0",
    "@lhci/cli": "0.16.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bun": "1.4.5",
    "@types/spdx-expression-parse": "4.0.0",
    "astro": "7.4.13",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-check": "4.11.0",
    "html-validate": "11.21.1",
    "lefthook": "2.2.2",
    "linkinator": "8.1.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "spdx-expression-parse": "5.0.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "basic-ftp": "6.2.6"
  }
}
