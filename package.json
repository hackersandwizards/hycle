{
  "name": "hycle-org",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "hycle.org: Astro-Seiten, gebaut nach dist/, ohne JavaScript auf der Seite.",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://hycle.org",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate dist/index.html dist/changelog.html dist/talks/index.html",
    "lint:css": "stylelint public/style.css",
    "lint": "bun run lint:html && bun run lint:css",
    "links": "linkinator index.html talks/index.html --server-root dist --recurse --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "links:external": "linkinator index.html talks/index.html --server-root dist --recurse",
    "lighthouse": "bunx @lhci/cli@0.15.1 autorun",
    "gen:sitemap": "bun scripts/gen-sitemap.mjs",
    "gen:assets": "bun scripts/gen-assets.mjs",
    "audit": "bun audit --audit-level=high",
    "check": "bun run format:check && bun run build && bun run lint && bun run gen:sitemap --check && bun run links"
  },
  "devDependencies": {
    "astro": "7.4.5",
    "html-validate": "11.18.0",
    "lefthook": "2.2.2",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
