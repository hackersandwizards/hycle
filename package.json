{
  "name": "hycle-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "hycle.org: Astro-Seiten, gebaut nach dist/, ohne JavaScript auf der Seite.",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://hycle.org",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate dist",
    "lint:css": "stylelint public/style.css",
    "lint": "bun run lint:html && bun run lint:css",
    "links": "bun run links:external --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "links:external": "linkinator '**/*.html' --server-root dist",
    "lighthouse": "lhci autorun",
    "gen:sitemap": "bun scripts/gen-sitemap.mjs",
    "gen:assets": "bun scripts/gen-assets.mjs",
    "audit": "bun audit --audit-level=high",
    "check": "bun run format:check && bun run build && bun run lint && bun run gen:sitemap --check && bun run links && bun run test",
    "test": "bun test scripts"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "astro": "7.4.7",
    "html-validate": "11.19.0",
    "lefthook": "2.2.2",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5",
    "basic-ftp": "6.2.6"
  }
}
